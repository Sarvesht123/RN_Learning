# Adobe Commerce GraphQL configuration (public values only).
EXPO_PUBLIC_GRAPHQL_URL=http://aed.staging.com/graphql
EXPO_PUBLIC_STORE_CODE=default

# Set true only when learning offline with src/data fixtures.
EXPO_PUBLIC_USE_MOCKS=false

# Keep screens usable when staging DNS/API is temporarily unavailable.
EXPO_PUBLIC_ALLOW_FIXTURE_FALLBACK=false

# Source used for product availability and the learning checkout location.
EXPO_PUBLIC_SOURCE_CODE=dip_ds
